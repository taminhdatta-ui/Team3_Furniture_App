<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_cart_card"
    android:padding="12dp">

    <!-- Checkbox vuông màu xanh đậm -->
    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:checked="true"
        android:buttonTint="#0C5E43"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Khung nền xám nhạt bo tròn chứa ảnh ghế -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardImg"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E6E7E9"
        app:layout_constraintStart_toEndOf="@id/cbSelect"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="6dp" />
    </androidx.cardview.widget.CardView>

    <!-- Tên sản phẩm -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Yellow Chair"
        android:textColor="#1A1D1E"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/cardImg"
        app:layout_constraintEnd_toStartOf="@id/layoutQuantity"
        app:layout_constraintTop_toTopOf="@id/cardImg" />

    <!-- Dòng loại sản phẩm mờ -->
    <TextView
        android:id="@+id/tvType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Armchair High"
        android:textColor="#A0A4A8"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintEnd_toStartOf="@id/layoutQuantity"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <!-- Giá tiền đậm -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="$80"
        android:textColor="#1A1D1E"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvType" />

    <!-- Cụm nút - 1 + có viền đen con nhộng -->
    <LinearLayout
        android:id="@+id/layoutQuantity"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_quantity"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="—"
            android:textColor="#1A1D1E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="#1A1D1E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="#1A1D1E"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>