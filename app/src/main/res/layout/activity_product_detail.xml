<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/back"
                android:padding="10dp"
                android:src="@drawable/ic_back_chevron"
                app:tint="#104035"
                tools:ignore="TouchTargetSizeCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/favorite"
                android:padding="10dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="#104035"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/share"
                android:padding="10dp"
                android:src="@drawable/ic_send_share"
                app:tint="#104035"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageButton
                android:id="@+id/btn3D"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/_3d_view"
                android:padding="10dp"
                android:src="@drawable/ic_cube_3d"
                app:tint="#104035"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Product image and 360-degree hint -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:contentDescription="@string/modern_chair_title"
            android:scaleType="fitCenter"
            android:src="@drawable/blue_white_chair" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:text="@string/degree_360"
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- Product information card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtProductName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/modern_chair_title"
                    android:textColor="#104035"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modern_chair_price"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/rating"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#FFC107"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/rating_text"
                    android:textColor="#757575"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Color selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/color_label"
                    android:textColor="#104035"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/colorLight"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_color_light"
                    android:clickable="true"
                    android:contentDescription="@string/light_color"
                    android:focusable="true"
                    tools:ignore="TouchTargetSizeCheck" />

                <View
                    android:id="@+id/colorGray"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_color_gray"
                    android:clickable="true"
                    android:contentDescription="@string/gray_color"
                    android:focusable="true"
                    tools:ignore="TouchTargetSizeCheck" />

                <View
                    android:id="@+id/colorRed"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_color_red"
                    android:clickable="true"
                    android:contentDescription="@string/red_color"
                    android:focusable="true"
                    tools:ignore="TouchTargetSizeCheck" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="26dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_quantity"
                    android:contentDescription="@string/decrease_quantity"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#111111"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/txtQuantity"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/_1"
                    android:textColor="#111111"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_quantity"
                    android:contentDescription="@string/increase_quantity"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#111111"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabOverview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="@string/tab_overview"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabMaterial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="@string/tab_material"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/tabReview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:text="@string/tab_review"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/about_product"
                android:textColor="#104035"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:text="@string/product_description"
                android:textColor="#757575"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnReadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/read_more"
                android:textColor="#104035"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_add_to_cart"
                android:gravity="center"
                android:text="@string/add_to_cart_full"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="134dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_home_indicator" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
